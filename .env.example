# Copy to .env.local; existing environment variables take precedence.
# stage or production; independent of GIN_MODE.
APP_ENV=stage
# debug, info, warn or error; shared by JSON stdout and Sentry logs.
LOG_LEVEL=info
HTTP_ADDR=127.0.0.1:8080
GIN_MODE=release
# Empty: HTTP-only mode. Set a PostgreSQL DSN to enable database readiness.
DATABASE_URL=

# Required for database-backed API startup; migrations do not require Clerk.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_API_ENDPOINT=https://api.clerk.com
CLERK_ISSUER_URL=
# Comma-separated exact origins. Empty permits only tokens without azp.
CLERK_AUTHORIZED_PARTIES=

# Market reference rates; only the worker (just worker) fetches them.
FRANKFURTER_ENDPOINT=https://api.frankfurter.dev
# Comma-separated provider keys. Empty uses Frankfurter's blended feed.
FX_PROVIDERS=
FX_RETENTION_DAYS=30
FX_HTTP_TIMEOUT=5s

# Reserved configuration; no LLM calls are made by this scaffold.
LLM_ENDPOINT=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=

# Reserved S3 configuration; no uploads are made by this scaffold.
# Leave endpoint empty for the standard AWS endpoint; set it for a custom service.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# Empty disables Sentry entirely. Non-empty enables sentrygin tracing and slog logs.
# Trace sampling: stage=100%, production=50%; error/log events are not sampled.
SENTRY_DSN=

# Defaults to true in stage and false in production.
# DOCS_ENABLED=true
