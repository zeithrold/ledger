          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "201": {
            "description": "New identity and personal space created atomically.",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated request correlation UUID.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "X-Ledger-API-Version": {
                "description": "Present only after a version is accepted.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "2026-09-14"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserContext"
                }
              }
            }
          }
        },
        "description": "The first successful bootstrap transaction also claims instance administrator. New identities require currency, timezone and locale; repeats return existing context without changes. Disabled users cannot reactivate themselves.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapInput"
              },
              "example": {
                "base_currency": "CNY",
                "timezone": "Asia/Shanghai",
                "locale": "zh-CN"
              }
            }
          }
        }
      }
    },
