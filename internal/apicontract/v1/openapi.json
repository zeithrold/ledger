{
  "openapi": "3.1.0",
  "info": {
    "title": "Ledger API v1",
    "version": "2026-09-14",
    "description": "Personal finance backend. Path major version and exact date header jointly identify the contract. Documentation is public when enabled; business operations require a Clerk session token.",
    "license": {
      "name": "MIT"
    }
  },
  "x-ledger-major": "v1",
  "servers": [
    {
      "url": "/",
      "description": "Same-origin Ledger API"
    }
  ],
  "security": [
    {
      "ClerkSession": []
    }
  ],
  "tags": [
