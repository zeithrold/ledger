  "components": {
    "securitySchemes": {
      "ClerkSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Paste a short-lived Clerk session token, not a backend API key. Scalar does not sign in or refresh tokens."
      }
    },
    "parameters": {
      "APIVersion": {
        "name": "X-Ledger-API-Version",
        "in": "header",
        "required": true,
        "description": "Exact contract date. Missing, malformed and retired dates are rejected before authentication.",
        "schema": {
          "type": "string",
          "enum": [
            "2026-09-14"
          ],
          "default": "2026-09-14"
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "status"
        ]
      },
      "Tenant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "Book": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "base_currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "tenant_id",
          "name",
          "base_currency"
        ]
      },
      "Preferences": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "locale",
          "timezone",
          "theme"
        ]
      },
      "UserContext": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "instance_role": {
            "type": "string",
            "enum": [
              "admin",
              "user"
            ]
          },
          "tenant": {
            "$ref": "#/components/schemas/Tenant"
          },
          "default_book": {
            "$ref": "#/components/schemas/Book"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          }
        },
        "additionalProperties": false,
        "required": [
          "user",
          "instance_role",
          "tenant",
          "default_book",
          "preferences"
        ]
      },
      "BootstrapInput": {
        "type": "object",
        "properties": {
          "base_currency": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required on first initialization: uppercase ISO 4217 code."
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required on first initialization: IANA timezone, excluding Local."
          },
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required on first initialization: BCP 47 language tag."
          }
        },
        "additionalProperties": false,
        "description": "All three values are required only for a new identity. Existing identities may send an empty body or any supported initialization fields; stored settings are never overwritten. This database-dependent rule is enforced by the service."
      },
      "PreferencesPatch": {
        "type": "object",
        "properties": {
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "BCP 47 locale. Null is ignored."
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ],
            "description": "IANA timezone, excluding Local. Null is ignored."
          },
          "theme": {
            "type": [
              "string",
              "null"
            ],
            "description": "system, light or dark. Null is ignored."
          }
        },
        "additionalProperties": false,
        "description": "At least one non-null field is required; validation is performed by the service."
      },
      "StatusInput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Nonblank reason, maximum 1000 UTF-8 bytes."
          }
        },
        "additionalProperties": false,
        "required": [
          "status",
          "reason"
        ]
      },
      "Instance": {
        "type": "object",
        "properties": {
          "admin_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "initialized_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "required": [
          "admin_user_id",
          "initialized_at"
        ]
      },
      "UserPage": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "required": [
          "users",
          "next_cursor"
        ]
      },
      "BookList": {
        "type": "object",
        "properties": {
          "books": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Book"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "books"
        ]
      },
      "Health": {
        "type": "object",
